rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // REUSABLE GLOBALS
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming(req) {
      return req.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ENTITY VALIDATION HELPERS
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200
        && data.plan in ['free', 'creator', 'studio']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidProject(data) {
      return data.uid == request.auth.uid
        && data.projectId is string && data.projectId.size() <= 128
        && data.type in ['song', 'video', 'quran', 'slides']
        && data.inputData is map
        && data.aiOutput is map
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt; // Immortal createdAt
      allow delete: if false; // Profile removal strictly disabled on the client side
    }

    // PROJECTS COLLECTION
    match /projects/{projectId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(request.resource.data);
      allow update: if isSignedIn() && isValidId(projectId) && resource.data.uid == request.auth.uid 
        && isValidProject(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt; // Immortal createdAt
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
